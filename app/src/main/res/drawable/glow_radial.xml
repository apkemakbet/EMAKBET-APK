<?xml version="1.0" encoding="utf-8"?>
<!-- Cahaya lembut di belakang logo splash (radial gradient, makin ke tepi makin transparan) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="150dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#552FF3D0"
        android:centerColor="#221A7A3D"
        android:endColor="#000A1A14" />
</shape>
